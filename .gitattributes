# Normalize line endings explicitly: repo default core.autocrlf=true would
# otherwise silently rewrite LF artifacts to CRLF on a fresh checkout.
/.gitignore text eol=lf
/.gitattributes text eol=lf
*.py  text eol=lf
*.js  text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf
*.png binary
*.jpg binary
*.svg text
